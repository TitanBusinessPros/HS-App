rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleAccount() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function active() {
      return googleAccount() && !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid));
    }
    function isAdmin() {
      return active() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function companyAdmin(companyId) {
      return isAdmin() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.companyId == companyId;
    }
    function titanAdmin() {
      return isAdmin() && (!('companyId' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data) ||
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.companyId == 'titan');
    }
    function owns(uid) {
      return active() && request.auth.uid == uid;
    }
    function companyApplicant(companyId, uid) {
      return owns(uid) && !exists(/databases/$(database)/documents/companies/$(companyId)/blockedApplicants/$(uid));
    }

    // All profile and message writes go through moderated Cloud Functions.
    match /admins/{uid} {
      allow get: if active() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /blockedUsers/{uid} {
      allow get: if (googleAccount() && request.auth.uid == uid) || titanAdmin();
      allow list: if titanAdmin();
      allow write: if false;
    }
    match /users/{uid} {
      allow get: if owns(uid) || titanAdmin();
      allow list: if titanAdmin();
      allow write: if false;
    }
    match /applicantDirectory/{uid} {
      allow get, list: if isAdmin();
      allow write: if false;
    }
    match /applicantSummaries/{uid} {
      allow get, list: if titanAdmin();
      allow write: if false;
    }
    match /teams/{teamId} {
      allow get, list: if titanAdmin();
      allow write: if false;
      match /members/{uid} {
        allow get, list: if titanAdmin();
        allow write: if false;
      }
    }
    match /questionnaires/{uid} {
      allow get: if owns(uid) || titanAdmin();
      allow list, write: if false;
    }
    match /questionnaireConfig/{configId} {
      allow get: if active() && configId == 'main';
      allow list, write: if false;
    }
    match /skills/{uid} {
      allow get: if owns(uid) || titanAdmin();
      allow list, write: if false;
    }
    match /skillCatalog/{skillId} {
      allow get, list: if active();
      allow write: if false;
    }
    match /skillRankings/{skillId}/applicants/{uid} {
      allow get, list: if titanAdmin();
      allow write: if false;
    }
    match /homesteadPage/{pageId} {
      allow get: if pageId == 'main' && (active() || resource.data.published == true);
      allow list, write: if false;
    }
    match /homesteadPhotos/{photoId} {
      allow get, list: if titanAdmin() || (
        exists(/databases/$(database)/documents/homesteadPage/main) &&
        get(/databases/$(database)/documents/homesteadPage/main).data.published == true);
      allow write: if false;
    }
    match /conversations/{uid} {
      allow get: if titanAdmin();
      allow list: if titanAdmin();
      allow write: if false;
      match /messages/{messageId} {
        allow get, list: if owns(uid) || titanAdmin();
        allow write: if false;
      }
    }
    match /companyListings/{companyId} {
      allow get, list: if active();
      allow write: if false;
    }
    match /companies/{companyId} {
      allow get: if companyAdmin(companyId);
      allow list, write: if false;
      match /applications/{uid} {
        allow get: if companyApplicant(companyId, uid) || companyAdmin(companyId);
        allow list: if companyAdmin(companyId);
        allow write: if false;
      }
      match /applicantSummaries/{uid} {
        allow get, list: if companyAdmin(companyId);
        allow write: if false;
      }
      match /blockedApplicants/{uid} {
        allow get: if owns(uid) || companyAdmin(companyId);
        allow list: if companyAdmin(companyId);
        allow write: if false;
      }
      match /teams/{teamId} {
        allow get, list: if companyAdmin(companyId);
        allow write: if false;
        match /members/{uid} {
          allow get, list: if companyAdmin(companyId);
          allow write: if false;
        }
      }
      match /questionnaires/{uid} {
        allow get: if companyApplicant(companyId, uid) || companyAdmin(companyId);
        allow list, write: if false;
      }
      match /questionnaireConfig/{configId} {
        allow get: if active() && configId == 'main';
        allow list, write: if false;
      }
      match /skills/{uid} {
        allow get: if companyApplicant(companyId, uid) || companyAdmin(companyId);
        allow list, write: if false;
      }
      match /skillCatalog/{skillId} {
        allow get, list: if active();
        allow write: if false;
      }
      match /skillRankings/{skillId}/applicants/{uid} {
        allow get, list: if companyAdmin(companyId);
        allow write: if false;
      }
      match /homesteadPage/{pageId} {
        allow get: if pageId == 'main' && (active() || (resource.data.published == true &&
          exists(/databases/$(database)/documents/companies/$(companyId)) &&
          get(/databases/$(database)/documents/companies/$(companyId)).data.active == true));
        allow list, write: if false;
      }
      match /homesteadPhotos/{photoId} {
        allow get, list: if companyAdmin(companyId) || (
          exists(/databases/$(database)/documents/companies/$(companyId)) &&
          get(/databases/$(database)/documents/companies/$(companyId)).data.active == true &&
          exists(/databases/$(database)/documents/companies/$(companyId)/homesteadPage/main) &&
          get(/databases/$(database)/documents/companies/$(companyId)/homesteadPage/main).data.published == true);
        allow write: if false;
      }
      match /conversations/{uid} {
        allow get, list: if companyAdmin(companyId);
        allow write: if false;
        match /messages/{messageId} {
          allow get, list: if companyApplicant(companyId, uid) || companyAdmin(companyId);
          allow write: if false;
        }
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
