rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleAccount() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function active() {
      return googleAccount() && !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid));
    }
    function isAdmin() {
      return active() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function owns(uid) {
      return active() && request.auth.uid == uid;
    }

    // All profile and message writes go through moderated Cloud Functions.
    match /admins/{uid} {
      allow get: if active() && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /blockedUsers/{uid} {
      allow get: if (googleAccount() && request.auth.uid == uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }
    match /users/{uid} {
      allow get: if owns(uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }
    match /conversations/{uid} {
      allow get: if owns(uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
      match /messages/{messageId} {
        allow get, list: if owns(uid) || isAdmin();
        allow write: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
